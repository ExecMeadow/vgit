{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Directory
    "rootDir": "../",
    // Compilation Restriction
    "noEmit": true,
    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    // Recommended Options
    "strict": true
  },
  // Only type-check ts files located in this directory.
  "include": ["./**/*"]
}
