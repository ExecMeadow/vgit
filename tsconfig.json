{
  "compilerOptions": {
    // Filepath
    "rootDir": "src",
    "outDir": "dist",
    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    // Recommended Options
    "strict": true
  },
  // Only compile ts files located in the src directory.
  "include": ["src"]
}
